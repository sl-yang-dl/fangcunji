# ============================================================
# 本地开发环境变量示例（复制为 .env 后按需修改）
# 部署到 GitHub Pages 时，VITE_GITHUB_REPO 会由 CI 自动注入，无需本地设置。
# ============================================================

# 留言功能提交到哪个仓库（格式：owner/repo）
VITE_GITHUB_REPO="your-name/your-repo"

# 留言板 · GitHub Actions 代理方案（推荐，更安全）
# ------------------------------------------------------------
# 前端通过该令牌触发 .github/workflows/guestbook-proxy.yml，
# 真正创建 Issue 使用的是仓库的 GITHUB_TOKEN（repo secret），
# 因此该令牌不需要创建 Issue 的权限，仅需：
#   - 触发 workflow_dispatch：actions:write（本仓库）
# 建议使用 Fine-grained PAT，权限最小化，仅限本仓库，可随时吊销。
#
# 未配置时前端会优雅提示，不会报错；配置后留言即可真正写入 Issues。
VITE_GUESTBOOK_TOKEN="github_pat_xxxxxxxx"

# 以下变量已废弃（旧方案：直接调用 Issues API 并暴露 token）
# VITE_GITHUB_TOKEN="ghp_xxxxxxxx"   # 不要使用，会暴露在前端
